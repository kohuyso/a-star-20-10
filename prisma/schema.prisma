generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String        @id @default(uuid())
  username     String        @unique
  passwordHash String
  fullName     String
  role         String        @default("PLAYER") // "PLAYER" | "ADMIN"
  gender       String        @default("MALE") // "MALE" | "FEMALE"
  createdAt    DateTime      @default(now())
  votes        Vote[]
  wonRounds    RoundResult[]
}

model FemaleProfile {
  id          String        @id @default(uuid())
  name        String        @unique
  avatarUrl   String?
  hint        String?
  orderIndex  Int           @default(0)
  questions   Question[]
  roundResult RoundResult?
}

model Question {
  id              String        @id @default(uuid())
  questionNumber  Int           @unique
  femaleProfileId String
  photoUrl        String
  isActive        Boolean       @default(true)
  femaleProfile   FemaleProfile @relation(fields: [femaleProfileId], references: [id], onDelete: Cascade)
  votes           Vote[]
}

model Vote {
  id           String   @id @default(uuid())
  userId       String
  questionId   String
  selectedName String
  isCorrect    Boolean  @default(false)
  answeredAt   DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@unique([userId, selectedName])
  @@index([questionId, isCorrect, answeredAt])
}

model GameState {
  id                    String    @id @default("default")
  status                String    @default("LOBBY") // "LOBBY" | "VOTING" | "CLOSED" | "REVEAL"
  currentQuestionNumber Int       @default(1) // 1 đến 14
  isQuestionActive      Boolean   @default(false) // Admin mở/khóa nhận câu trả lời cho câu hiện tại
  timerDurationSec      Int       @default(20) // Thời gian quy định (giây)
  timerStartedAt        DateTime? // Mốc thời gian bắt đầu đếm ngược
  currentSlideIndex     Int       @default(0)
  activeRevealRound     Int       @default(0)
  slideDurationSec      Int       @default(15)
  updatedAt             DateTime  @updatedAt
}

model RoundResult {
  id                   String   @id @default(uuid())
  femaleProfileId      String   @unique
  assignedUserId       String?
  totalCorrectGuesses  Int      @default(0)
  totalGuesses         Int      @default(0)
  selectionReason      String   @default("FASTEST_CORRECT") // "FASTEST_CORRECT" | "FASTEST_INCORRECT" | "MANUAL"
  revealedAt           DateTime @default(now())

  femaleProfile FemaleProfile @relation(fields: [femaleProfileId], references: [id], onDelete: Cascade)
  assignedUser  User?         @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
}
